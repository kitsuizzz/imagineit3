# Database
DB_ENGINE=mysql
DB_DRIVER=aiomysql
DB_USER=myuser
DB_PASSWORD=very_secure_pass
DB_HOST=localhost
DB_PORT=3306
DB_NAME=imagineit-db
DB_ROOT_PASSWORD=extremely_secure_root_pass
DB_ECHO=false

# MinIO
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=intensely_private_and_secure_root_password
MINIO_HOST=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Valkey
VALKEY_PORT=6379
VALKEY_HOST=localhost
VALKEY_PASSWORD=unpredictably_complicated_and_secure_pass

# Accounts + encryption
# 32+ characters. Encrypts per-user Kaggle credentials at rest. It is NOT used
# for inference content: prompts and images are sealed to the browser's key and
# this process cannot open them.
APP_SECRET=replace_me_with_at_least_32_random_characters

# Browserful agent (drives the per-user Kaggle session)
BROWSERFUL_KEY=
# BROWSERFUL_URL=https://browserful.kitsui.co

# GPU worker gateway
GPU_WORKERS_FILE=gpu_workers.json
WORKER_HEARTBEAT_INTERVAL=15
WORKER_LEASE_SECONDS=300
WORKER_DISCONNECT_GRACE_SECONDS=60
MAX_RESULT_BYTES=8388608

# GPU host settings (used by gpu_worker.py)
APP_WS_URL=ws://localhost:4600/internal/v1/workers/ws
GPU_WORKER_KEY_FILE=~/.imagineit/worker.json
GPU_MODEL=wssdaas/nova-anime-xl-ilv-19.0
GPU_WORKER_GPUS=1
LOG_LEVEL=INFO
